    "Host": "rabbitmq",
    "VirtualHost": "/"
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "SpecialCharacters": "!@#$%^&*()_+-=[]{}|;':\",./<>?"
  },
  "InviteSettings": {
    "TokenExpiryHours": 48,
    "FrontendUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "CRM System",
    "SecureSocketOptions": "StartTlsWhenAvailable"
  }
}
