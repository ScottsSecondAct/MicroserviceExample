{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DefaultAdmin": {
    "UserId": "00000000-0000-0000-0000-000000000001",
    "Email": "admin@example.com",
    "Password": "",
    "Username": "admin"
  },
  "DefaultTenant": {
    "TenantId": "00000000-0000-0000-0000-000000000010",
    "Slug": "default",
    "DisplayName": "Default Tenant"
  },
  "TenantProvisioning": {
    "BootstrapSecret": ""
  },
  "ServiceUrls": {
    "UserManagementService": "http://user-management-service:8080"
  },
