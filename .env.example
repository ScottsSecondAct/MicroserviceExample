# Copy this file to .env and fill in the values before running docker compose.
# The .env file is git-ignored and must never be committed.

# JWT signing secret — use a long random string (32+ characters)
JWT_SECRET=replace-this-with-a-secure-random-secret

# Default admin seed password (AuthService startup seeding)
DEFAULT_ADMIN_PASSWORD=replace-this-with-a-secure-admin-password

# RabbitMQ credentials
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Database passwords (one per service — use unique values in production)
AUTH_DB_PASSWORD=replace-this-with-a-secure-password
USER_DB_PASSWORD=replace-this-with-a-secure-password
ACCOUNT_DB_PASSWORD=replace-this-with-a-secure-password
CONTACT_DB_PASSWORD=replace-this-with-a-secure-password
DEAL_DB_PASSWORD=replace-this-with-a-secure-password
ACTIVITY_DB_PASSWORD=replace-this-with-a-secure-password
REPORTING_DB_PASSWORD=replace-this-with-a-secure-password
